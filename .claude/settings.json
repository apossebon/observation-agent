{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_observation.sh", "timeout": 60 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log_subagent.sh", "timeout": 10 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Bash(PYTHONPATH=src python3 *)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(sleep *)",
      "Bash(./serve.sh *)",
      "Read(corpus/**)",
      "Read(out/**)",
      "Write(out/**)",
      "Edit(out/**)"
    ]
  }
}
